# =========================================================================
# THE JOURNAL — Environment Variables Template (.env.example)
# =========================================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/blogdb
DB_USERNAME=postgres
DB_PASSWORD=My123456789!

# Jasypt Master Encryption Key
JASYPT_ENCRYPTOR_PASSWORD=myblog-secret-key-1234

# JWT Security
JWT_SECRET_KEY=study-springboot-jwt-secret-key-study-springboot-jwt-secret-key

# OAuth2 Google Social Login (Optional: Required only for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Super Admin Account (Initial Bootstrap)
ADMIN_EMAIL=admin@myblog.com
ADMIN_PASSWORD=admin1234

# File Upload Directory (Default: ./uploads)
FILE_UPLOAD_DIR=./uploads
